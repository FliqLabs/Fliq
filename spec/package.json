{
  "name": "@fliq/spec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./ts/index.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "generate": "openapi-typescript openapi.yaml -o ts/openapi.ts",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "pnpm lint && pnpm check:fixtures && pnpm check:generated"
  },
  "devDependencies": {
    "@redocly/cli": "1.25.15",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "yaml": "2.6.1"
  }
}
