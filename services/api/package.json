{
  "name": "@fliq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mock": "tsx src/mock.ts",
    "stack:up": "docker compose -f infra/compose.yaml up --build --wait",
    "stack:down": "docker compose -f infra/compose.yaml down",
    "stack:reset": "docker compose -f infra/compose.yaml down --volumes",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:relayer": "tsx --env-file=.env apps/relayer/src/server.ts",
    "dev": "tsx --env-file=.env apps/api/src/server.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "start": "tsx apps/api/src/server.ts",
    "start:relayer": "tsx apps/relayer/src/server.ts",
    "mcp": "tsx apps/mcp/src/server.ts",
    "mcp:keygen": "tsx apps/mcp/src/keygen.ts",
    "dev:oneclick-mock": "tsx packages/chains/oneclick/server.ts",
    "vault:testnet": "tsx --env-file=.env scripts/vault-testnet.ts"
  },
  "dependencies": {
    "@fliq/spec": "workspace:*",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/server": "13.3.3",
    "borsh": "2.0.0",
    "fastify": "5.12.8",
    "ioredis": "5.8.2",
    "near-api-js": "7.4.0",
    "viem": "2.21.54",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
