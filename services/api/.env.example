FLIQ_HASH_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
EMAIL_LINK_BASE_URL=http://localhost:3000
NEAR_ROOT_ACCOUNT=fliq.near
VAULT_ACCOUNT=fliq-vault.testnet

# local, sandbox or production. Sandbox and production rules are stricter (TLS broker, mainnet only in production).
FLIQ_ENV=local

DATABASE_URL=postgres://fliq:fliq-local-only@localhost:5432/fliq
REDIS_URL=redis://localhost:6379
AMQP_URL=amqp://fliq:fliq-local-only@localhost:5672

BASE_RPC_URL=http://localhost:8545
POLYGON_RPC_URL=http://localhost:8546
SOLANA_RPC_URL=http://localhost:8899

# sandbox (local NEAR sandbox), testnet or mainnet
NEAR_NETWORK=sandbox
NEAR_RPC_URL=http://localhost:3030
VAULT_CONTRACT_ID=vault.test.near
USDC_CONTRACT_ID=usdc.test.near

# Function-call key limited to the vault: register_order, set_status, recredit
NEAR_REGISTRATION_ACCOUNT_ID=registrar.test.near
NEAR_REGISTRATION_PRIVATE_KEY=

ONECLICK_URL=http://localhost:4100
ONECLICK_API_KEY=
ONECLICK_FEE_RECIPIENT=fees.test.near
ONECLICK_APP_FEE_BPS=0
# 1Click deadline is the provider's address validity minus this. Paycrest's validity must be measured before trusting the default.
ONECLICK_DEADLINE_MARGIN_MS=300000

# Relayer pool: 1 key locally, 5 to 10 comma-separated keys in sandbox and production
RELAYER_URL=http://localhost:4200
RELAYER_ACCOUNT_ID=relayer.test.near
RELAYER_PRIVATE_KEYS=
RELAYER_AUTH_TOKEN=
RELAYER_AUTH_TOKEN_PREVIOUS=
RELAYER_PORT=4200

# Account creator: the key of NEAR_ROOT_ACCOUNT, which creates <name>.<root> for new users (separate from the gas pool)
NEAR_ROOT_PRIVATE_KEY=
NEAR_ACCOUNT_FUNDING_YOCTO=0
