PORT=4000
MOCK=1
FLIQ_TEST_KEYS=rt_test_7Kp2demo00c9Qe,rt_test_mcp_Q8demo001fA
PAYCREST_API_KEY=
PAYCREST_API_SECRET=
PAYCREST_API_SECRET_PREVIOUS=
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_ENVIRONMENT=
BITNOB_WEBHOOK_SECRET=
BITNOB_WEBHOOK_SECRET_PREVIOUS=
BITNOB_CALLBACK_URL=
BUSHA_SECRET_KEY=
BUSHA_ENVIRONMENT=
BUSHA_WEBHOOK_SECRET=
BUSHA_WEBHOOK_SECRET_PREVIOUS=
# 1 shows Busha's prices with no key (public quote endpoint); payouts still need BUSHA_SECRET_KEY.
BUSHA_PUBLIC_QUOTES=
# 1 allows real Busha payouts in production. Off until refunds into our Busha balance are handled.
BUSHA_ALLOW_PRODUCTION=
FONBNK_CLIENT_ID=
FONBNK_SIGNATURE_SECRET=
FONBNK_ENVIRONMENT=
FONBNK_WEBHOOK_SECRET=
FONBNK_WEBHOOK_SECRET_PREVIOUS=
FONBNK_USER_EMAIL=
FONBNK_USER_IP=
FONBNK_WEBHOOK_URL=
# fliq's own contact number in international digits (234...), sent when Fonbnk requires a recipient phone and none was given.
FONBNK_DEFAULT_PHONE=
TRANSFI_USERNAME=
TRANSFI_PASSWORD=
TRANSFI_MID=
TRANSFI_ENVIRONMENT=
TRANSFI_WEBHOOK_SECRET=
TRANSFI_WEBHOOK_SECRET_PREVIOUS=
# A KYC-approved TransFi sender (UX-...) and the IP sent as its device details on every off-ramp order
TRANSFI_SENDER_USER_ID=
TRANSFI_SENDER_IP=
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM="FLIQ <noreply@fliq.cash>"
FLIQ_ACCESS_SECRET=
FLIQ_DATA_KEY=
FLIQ_HASH_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
EMAIL_LINK_BASE_URL=http://localhost:3000
PAY_LINK_BASE_URL=http://localhost:3000/pay
NEAR_ROOT_ACCOUNT=fliq.near
VAULT_ACCOUNT=fliq-vault.testnet

# local, sandbox or production. Sandbox and production rules are stricter (TLS broker, mainnet only in production).
FLIQ_ENV=local

DATABASE_URL=postgres://fliq:fliq-local-only@localhost:5432/fliq
REDIS_URL=redis://localhost:6379
AMQP_URL=amqp://fliq:fliq-local-only@localhost:5672

BASE_RPC_URL=http://localhost:8545
POLYGON_RPC_URL=http://localhost:8546
# Read to show a Solana top-up as received within seconds. Unset, the public mainnet RPC is used.
SOLANA_RPC_URL=http://localhost:8899

# sandbox (local NEAR sandbox), testnet or mainnet
NEAR_NETWORK=sandbox
NEAR_RPC_URL=http://localhost:3030
# Must be the same account as VAULT_ACCOUNT: top-ups and refunds are sent there
VAULT_CONTRACT_ID=fliq-vault.testnet
USDC_CONTRACT_ID=usdc.test.near

# Function-call key limited to the vault: register_order, set_status, recredit, release_order.
# With it and NEAR_RPC_URL set, the API uses the deployed vault; without it, the in-memory MockVault.
NEAR_REGISTRATION_ACCOUNT_ID=registrar.test.near
NEAR_REGISTRATION_PRIVATE_KEY=
# Full-access key that pays the USDC storage_deposit for each new 1Click deposit address before its order opens.
# Required with the deployed vault; keep a little NEAR on the account (about 0.00125 NEAR per new address).
NEAR_STORAGE_PAYER_ACCOUNT_ID=
NEAR_STORAGE_PAYER_PRIVATE_KEY=

ONECLICK_URL=http://localhost:4100
ONECLICK_API_KEY=
ONECLICK_FEE_RECIPIENT=fees.test.near
ONECLICK_APP_FEE_BPS=0
# Refund address on dry pricing quotes. Must be a mainnet NEAR account: 1Click rejects testnet ones with a 400.
ONECLICK_PRICING_REFUND_TO=intents.near
# Where a provider refunds a payout it was funded for on each network (PROVIDER_REFUND_ADDRESS_<NETWORK>). An
# Intents payout funds Paycrest on Base, so it needs a Base address fliq controls. Without one, those payouts answer
# route_unavailable before any order exists. A refund that lands there is brought back to the vault and recredited.
PROVIDER_REFUND_ADDRESS_BASE=
PROVIDER_REFUND_ADDRESS_POLYGON=
PROVIDER_REFUND_ADDRESS_SOLANA=
# 1Click deadline is the provider's address validity minus this. Paycrest's validity must be measured before trusting the default.
ONECLICK_DEADLINE_MARGIN_MS=300000
# How often active payouts are re-checked with their provider, as the backstop to webhooks.
PAYOUT_WATCH_INTERVAL_MS=20000

# Relayer pool: 1 key locally, 5 to 10 comma-separated keys in sandbox and production.
# With RELAYER_URL and RELAYER_AUTH_TOKEN both set, the API creates each user's NEAR account when they claim a name
# and relays their signed vault calls; without the token it claims names with nothing on chain.
RELAYER_URL=http://localhost:4200
RELAYER_ACCOUNT_ID=relayer.test.near
RELAYER_PRIVATE_KEYS=
RELAYER_AUTH_TOKEN=
RELAYER_AUTH_TOKEN_PREVIOUS=
RELAYER_PORT=4200

# Account creator: the key of NEAR_ROOT_ACCOUNT, which creates <name>.<root> for new users (separate from the gas pool)
NEAR_ROOT_PRIVATE_KEY=
NEAR_ACCOUNT_FUNDING_YOCTO=0
# How often the API checks its own services and providers for the status page, in milliseconds
HEALTH_CHECK_INTERVAL_MS=60000
