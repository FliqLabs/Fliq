{
  "name": "@fliqlabs/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the fliq payouts API: quotes, payouts, account verification and webhook verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FliqLabs/Fliq.git",
    "directory": "services/api/sdk"
  },
  "homepage": "https://github.com/FliqLabs/Fliq/tree/main/services/api/sdk#readme",
  "keywords": [
    "fliq",
    "near",
    "stablecoin",
    "payouts",
    "offramp",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "publishConfig": {
