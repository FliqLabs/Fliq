// api: the app calls FLIQ_API_BASE_URL, the testnet API on Render.
// fixtures: the app reads spec/fixtures from its bundle, no server needed.
// For `make dev-mock`, set FLIQ_API_BASE_URL = http:/$()/localhost:4000/v1 and FLIQ_API_KEY = rt_test_7Kp2demo00c9Qe in Debug.xcconfig.local.
FLIQ_DATA_SOURCE = api
FLIQ_API_BASE_URL = https:/$()/api-production-54e10.up.railway.app/v1
FLIQ_API_KEY =
// Reads the device key's nonce and the latest block before a fliq-to-fliq payment is signed.
FLIQ_NEAR_RPC_URL = https:/$()/rpc.testnet.near.org
// testnet or mainnet. Receiving from other chains needs NEAR Intents, which only runs on mainnet.
FLIQ_NEAR_NETWORK = testnet
// Profile photos go to Cloudinary through an unsigned upload preset. Both values are public by design; the
// preset, set up in the Cloudinary dashboard, limits the folder, size and formats. Empty turns photo upload off.
FLIQ_CLOUDINARY_CLOUD = dz9nzikbp
FLIQ_CLOUDINARY_PRESET = fliq_avatars
// fliq's web server, which signs users in to Paj for bank deposits without the app holding Paj's key.
FLIQ_WEB_BASE_URL = https:/$()/fliq.cash
// A testnet build has no vault address on Solana, so Paj deposits go to this team wallet instead. Empty on mainnet.
FLIQ_PAJ_TEST_RECIPIENT = BX7M5C8ssXWreX9NpiG414qYVbfMoet9zTrzgNfFMc9M

// Names are sub-accounts of the API's NEAR_ROOT_ACCOUNT. The fixtures use fliq.near.
FLIQ_NAME_SUFFIX_api = .fliqaccount.testnet
FLIQ_NAME_SUFFIX_fixtures = .fliq.near
FLIQ_NAME_SUFFIX = $(FLIQ_NAME_SUFFIX_$(FLIQ_DATA_SOURCE))

// Names are sub-accounts of the API's NEAR_ROOT_ACCOUNT. The fixtures use fliq.near.
FLIQ_NAME_SUFFIX_api = .fliqaccount.testnet
FLIQ_NAME_SUFFIX_fixtures = .fliq.near
FLIQ_NAME_SUFFIX = $(FLIQ_NAME_SUFFIX_$(FLIQ_DATA_SOURCE))

// Set to ?mode=developer to read fliq.cash's apple-app-site-association directly instead of through Apple's CDN.
// That needs Settings > Developer > Associated Domains Development on the device.
FLIQ_ASSOCIATED_DOMAIN_MODE =

#include? "Debug.xcconfig.local"
