// Render until api.fliq.cash points at it.
// The testnet app. Config/Mainnet.xcconfig builds a second app beside it.
FLIQ_BUNDLE_ID = cash.fliq.app
FLIQ_DISPLAY_NAME = fliq
FLIQ_DATA_SOURCE = api
FLIQ_API_BASE_URL = https:/$()/api-production-54e10.up.railway.app/v1
FLIQ_API_KEY =
FLIQ_NEAR_RPC_URL = https:/$()/rpc.testnet.near.org
FLIQ_NEAR_NETWORK = testnet
// Profile photos go to Cloudinary through an unsigned upload preset. Both values are public by design; the
// preset, set up in the Cloudinary dashboard, limits the folder, size and formats. Empty turns photo upload off.
FLIQ_CLOUDINARY_CLOUD = dz9nzikbp
FLIQ_CLOUDINARY_PRESET = fliq_avatars
// fliq's web server, which signs users in to Paj for bank deposits without the app holding Paj's key.
FLIQ_WEB_BASE_URL = https:/$()/fliq.cash
// A testnet build has no vault address on Solana, so Paj deposits go to this team wallet instead. Empty on mainnet.
FLIQ_PAJ_TEST_RECIPIENT =
FLIQ_NAME_SUFFIX = .fliqaccount.testnet
FLIQ_ASSOCIATED_DOMAIN_MODE =
